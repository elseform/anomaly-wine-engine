    "i386",
    "x86_64"
  ],
  "minimumSetupToolVersion": null,
  "patches": [
    "crossover-26.3.0-wine-11.16-port.patch",
    "anomaly-advapi32-consistent-username-opt-in.patch",
    "anomaly-ntdll-mono-last-error-gs.patch",
    "anomaly-winemac-host-app-icon.patch",
    "anomaly-winemac-cross-process-child-swapchain.patch",
    "anomaly-nsiproxy-null-ifaddr-and-leaks.patch",
    "anomaly-ntdll-unwind-null-guards.patch",
    "anomaly-winegstreamer-bundled-plugins-and-pool.patch",
    "anomaly-faudio-26.08.patch",
    "a6-final-same-view-backing-sync.patch",
    "w1-win32u-vulkan-soname.patch",
    "wine-11.1-rtlwalkframechain-null-function.patch",
    "cyder-ntdll-frame-walk-page-fault-guard.patch",
    "cyder-wineserver-sock-reselect-pseudo-fd.patch",
    "cyder-wineserver-poll-slot-guard.patch",
    "cyder-wineserver-exit-diagnostics.patch",
