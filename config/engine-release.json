    "cyder-wineserver-sock-rebind-async-fd.patch",
    "cyder-wineserver-async-terminate-null-fd.patch",
    "cyder-wineserver-free-async-queue-null-fd.patch",
    "cyder-wineserver-pipe-end-disconnect-null-fd.patch",
