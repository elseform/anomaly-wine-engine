+         '\\','M','a','i','n','T','h','r','e','a','d','H','a','c','k',0};
+
+    res = RegOpenKeyW(HKEY_CURRENT_USER, enable_keyW, &key);
+    if(res == ERROR_SUCCESS) {
+        RegCloseKey(key);
+        FIXME("CXHACK: Using separated main thread.\n");
+        gecko_main_thread_config = TRUE;
+    }
+
+    return TRUE;
+}
