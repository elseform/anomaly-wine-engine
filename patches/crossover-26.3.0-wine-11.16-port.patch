+static BOOL sequoia_or_later(void)
+{
+    int result;
+    struct utsname name;
+    unsigned major, minor;
+
+    result = (uname( &name ) == 0 &&
+              sscanf( name.release, "%u.%u", &major, &minor ) == 2 &&
+              major >= 24 /* macOS 15 Sequoia */);
+
+    return (result == 1) ? TRUE : FALSE;
+}
