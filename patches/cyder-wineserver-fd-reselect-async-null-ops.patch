From cyder-wine-engine (Wine 11.0 / CrossOver 26.3.0), rebased onto Wine
11.16: differs in the guard, because Wine 11.16 falls back to
default_fd_reselect_async() when an fd has no reselect_async op. The 11.16 form is the one
built into engine builds 14-18.

--- a/server/fd.c
+++ b/server/fd.c
@@ -2275,6 +2275,16 @@
 
 void fd_reselect_async( struct fd *fd, struct async_queue *queue )
 {
+    /* A released or pseudo fd may have no ops; calling through NULL aborts
+     * wineserver (SIGSEGV at vtable offset) and hangs every client. */
+    if (!fd || !fd->fd_ops)
+    {
+        static int reported;
+
+        if (reported++ < 10)
+            wineserver_diag_printf( "wineserver: fd_reselect_async: missing ops for fd %p\n", fd );
+        return;
+    }
     if (fd->fd_ops->reselect_async) fd->fd_ops->reselect_async( fd, queue );
     else default_fd_reselect_async( fd, queue );
 }
