+bool macdrv_view_backing_sync_deferred(macdrv_view v)
+{
+    WineContentView* view = (WineContentView*)v;
+
+    if (![view isKindOfClass:[WineContentView class]])
+        return false;
+
+    return [view wine_isBackingSyncDeferred];
+}
+
+void macdrv_finalize_window_backing_sync(macdrv_window w)
+{
+    WineWindow* window = (WineWindow*)w;
+
+    if (!window) return;
+
+    OnMainThread(^{
+        set_view_backing_sync_deferred([window contentView], FALSE, TRUE);
+    });
+}
