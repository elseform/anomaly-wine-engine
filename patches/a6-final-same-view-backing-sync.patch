+static void set_view_backing_sync_deferred(NSView *root, BOOL deferred, BOOL finalize)
+{
+    if ([root isKindOfClass:[WineContentView class]])
+        [(WineContentView*)root wine_setBackingSyncDeferred:deferred finalize:finalize];
+
+    for (NSView *subview in [root subviews])
+        set_view_backing_sync_deferred(subview, deferred, finalize);
+}
