+/* Cyder: best-effort signal breadcrumbs (not strictly async-signal-safe,
+ * but do_sigsegv already used fprintf/abort). */
+static void wineserver_diag_sender_path( int pid, char *buf, size_t buflen )
+{
+    if (!buf || !buflen) return;
+    buf[0] = '\0';
+#ifdef __APPLE__
+    if (pid > 0)
+        proc_pidpath( pid, buf, buflen );
+#else
+    (void)pid;
+#endif
+}
+
+static void wineserver_diag_received_signal( int signum, const char *name, siginfo_t *si )
+{
+    char path[1024];
+    int pid = si ? (int)si->si_pid : -1;
+    int uid = si ? (int)si->si_uid : -1;
+
+    wineserver_diag_sender_path( pid, path, sizeof(path) );
+    if (path[0])
+        wineserver_diag_printf( "wineserver: received signal %d (%s) from pid %d uid %d path=%s\n",
+                                signum, name, pid, uid, path );
+    else
+        wineserver_diag_printf( "wineserver: received signal %d (%s) from pid %d uid %d\n",
+                                signum, name, pid, uid );
+}
